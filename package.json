{
  "name": "vehicle-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "24.x.x"
  },
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest --config ./jest.json",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "services:up": "docker compose -f infra/docker-compose.yml --env-file .env up -d --wait",
    "services:stop": "docker compose -f infra/docker-compose.yml stop",
    "services:down": "docker compose -f infra/docker-compose.yml down",
    "lint:prettier:check": "prettier --check",
    "lint:prettier:fix": "prettier --write",
    "lint:eslint:check": "eslint",
    "lint:staged:check": "lint-staged",
    "audit": "npm audit --omit=dev --audit-level=moderate",
    "audit:report": "npm audit --json > audit-report.json",
    "outdated": "npm outdated",
    "outdated:report": "npm outdated --json > outdated-report.json",
    "commit": "cz",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs}": [
      "eslint",
      "prettier --check"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@mikro-orm/core": "7.0.11",
    "@mikro-orm/decorators": "7.0.11",
    "@mikro-orm/mongodb": "7.0.11",
    "@mikro-orm/nestjs": "7.0.1",
    "@nestjs/common": "11.1.19",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.19",
    "@nestjs/platform-express": "11.1.19",
    "@nestjs/swagger": "11.3.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "helmet": "8.1.0",
    "nestjs-pino": "4.6.1",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@mikro-orm/cli": "7.0.11",
    "@mikro-orm/migrations": "7.0.11",
    "@mikro-orm/reflection": "7.0.11",
    "@mikro-orm/sqlite": "7.0.11",
    "@nestjs/cli": "11.0.21",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.19",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.26",
    "@swc/jest": "0.2.39",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "25.6.0",
    "@types/supertest": "7.2.0",
    "better-sqlite3": "12.9.0",
    "chokidar": "5.0.0",
    "commitizen": "4.3.1",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "10.2.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-no-secrets": "2.3.3",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "17.5.0",
    "husky": "9.1.7",
    "jest": "30.3.0",
    "lint-staged": "16.4.0",
    "prettier": "3.8.3",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.9",
    "ts-loader": "9.5.7",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.58.2"
  }
}
